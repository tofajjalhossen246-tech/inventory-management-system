# Required: Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
# Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Optional: password-recovery email (SMTP). If left blank, recovery codes are
# stored server-side only and are NEVER shown on screen. Real inbox delivery
# requires these four values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional sender address shown in recovery emails.
SMTP_FROM=
